# Environment Configuration Example
# Copy this file to .env.local and fill in your values. Never commit secrets.

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL="https://ijlrseclqymuzdcrruoz.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Supabase Server / Admin (Optional for client)
SUPABASE_SERVICE_ROLE_KEY=""

# Direct Database URL (Postgres connection for migrations)
DATABASE_URL=""

# ==============================================================================
# AI / Language Model (LLM) Configuration (ECP_AI_Prompt_Spec.md & Phase Plan §5.2)
# The application automatically detects available providers ("auto" mode).
# If no provider is configured, the system uses the deterministic offline fallback.
# ==============================================================================

# LLM Provider Selection: "auto" | "groq" | "openai" | "gemini" | "ollama"
LLM_PROVIDER="auto"

# Option 1: Groq (Recommended: Blazing fast, generous free tier for Llama 3)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile" # or "llama-3.1-8b-instant"

# Option 2: OpenAI / Compatible (OpenAI, DeepSeek, OpenRouter, Together)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Option 3: Google AI Studio REST
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Option 4: Local Ollama (100% private, offline hardware)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

